# ─────────────────────────────────────────────
#  AquaNet Puebla — Variables de entorno
#  Copia este archivo a .env y ajusta los valores
# ─────────────────────────────────────────────

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cambia-esta-clave-secreta-en-produccion

# PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquanet_puebla
DB_USER=aquanet_user
DB_PASSWORD=aquanet_password

# Cadena de conexión completa (alternativa)
DATABASE_URL=postgresql://aquanet_user:aquanet_password@localhost:5432/aquanet_puebla

# Uploads (fotos de evidencia)
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=5242880   # 5 MB en bytes

# Sesiones
SESSION_LIFETIME_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# APScheduler (recálculo IP)
SCHEDULER_ENABLED=true
PRIORITY_RECALC_INTERVAL_MINUTES=60

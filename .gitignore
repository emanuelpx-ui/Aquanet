# ─────────────────────────────────────────────
#  AquaNet Puebla — .gitignore
# ─────────────────────────────────────────────

# Variables de entorno y secretos
.env
.env.local
.env.*.local

# Entornos virtuales de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode y cachés de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Pruebas y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Archivos y fotos subidas en tiempo de ejecución (conservando .gitkeep)
app/static/uploads/*
!app/static/uploads/.gitkeep
!app/static/uploads/*.jpg
!app/static/uploads/*.jpeg
!app/static/uploads/*.png
!app/static/uploads/*.webp

# IDEs y Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs y depuración
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt
pip-delete-this-directory.txt

# Docker y bases de datos locales
.docker/
*.sqlite3
pgdata/
